# ZEMA — ortam değişkenleri şablonu
# Bu dosya repoda DURUR ve yalnızca anahtar ADLARINI içerir.
# Gerçek değerler .env.local'a yazılır ve .gitignore ile dışlanır (bkz. PLAN.md §3.2).

# ─── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SUNUCU TARAFI. NEXT_PUBLIC_ öneki VERME (PLAN.md §10.3).
# RLS'i baypas eder — job runner, rol atama ve seed işlemleri bunu kullanır.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Claude API ───────────────────────────────────────────────
# ⚠️ SUNUCU TARAFI. NEXT_PUBLIC_ öneki VERME.
ANTHROPIC_API_KEY=

# PLAN.md §4 bütçe kararı: claude-sonnet-5. Boş bırakılırsa kodda bu varsayılır.
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Geliştirme modu (PLAN.md §5.4 — "kredi tasarrufu için ZORUNLU") ──
# true  → gerçek API hiç çağrılmaz, lib/ai/fixtures/*.json döner
# false → gerçek Claude API çağrılır
# Geliştirme boyunca true tut. Yalnızca (a) bir kontrolü ilk kez uçtan uca
# test ederken, (b) deploy öncesi son doğrulamada false yap.
MOCK_AI=true

# ─── Kayıt kodları (PLAN.md §3.2) ─────────────────────────────
# Rol, kayıt ekranında seçilmez; yalnızca doğru kod girilirse atanır.
# Kod boş → competitor. Kod eşleşmezse → "Geçersiz kayıt kodu".
# GERÇEK DEĞERLERİ BURAYA ASLA YAZMA — sadece .env.local'a.
REGISTRATION_CODE_JUDGE=
REGISTRATION_CODE_COMPETITION_ADMIN=
REGISTRATION_CODE_EVALUATION_ADMIN=

# ─── Demo modu (PLAN.md §6) ───────────────────────────────────
# true iken /demo rotası erişilebilir (ana navigasyonda linklenmez).
# Üretimde false olmalı.
NEXT_PUBLIC_DEMO_MODE=false
